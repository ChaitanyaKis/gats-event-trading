# Copy to `.env` and edit. Every setting is optional; defaults are shown.
# All names map to fields in src/gats/config.py (prefix GATS_).

# --- storage ---
# GATS_DATA_DIR=data
# Default is SQLite at data/gats.db. For Postgres (e.g. on the VM):
# GATS_DB_URL=postgresql+psycopg://gats:password@localhost:5432/gats
# GATS_LOG_LEVEL=INFO

# --- politeness: keep these conservative; exchanges block aggressive clients ---
# GATS_MIN_REQUEST_INTERVAL_S=1.0
# GATS_HOST_MIN_INTERVAL_S='{"api.bseindia.com": 2.0}'
# GATS_BSE_PAGE_RETRIES=2
# GATS_BSE_PAGE_RETRY_DELAY_S=15
# GATS_MAX_RETRIES=4
# GATS_HTTP_TIMEOUT_S=20

# --- endpoints (fix here if `gats probe` shows they moved) ---
# GATS_BSE_ANNOUNCEMENTS_URL=https://api.bseindia.com/BseIndiaAPI/api/AnnSubCategoryGetData/w
# GATS_NSE_ANNOUNCEMENTS_URL=https://www.nseindia.com/api/corporate-announcements
# GATS_NSE_EOD_URL_TEMPLATE=https://nsearchives.nseindia.com/products/content/sec_bhavdata_full_{ddmmyyyy}.csv
# GATS_NSE_BANDS_URL=https://nsearchives.nseindia.com/content/equities/sec_list.csv
# GATS_NSE_INSTRUMENTS_URL=https://nsearchives.nseindia.com/content/equities/EQUITY_L.csv

# --- schedule ---
# GATS_BSE_POLL_S=30
# GATS_NSE_POLL_S=120
# GATS_NIGHT_POLL_MULTIPLIER=2.0
# GATS_ATTACHMENTS_ENABLED=true
# Attachment storage policy (URLs are always kept; skipped PDFs can be fetched later).
# GATS_ATTACHMENTS_MAX_MB=5
# Empty include list = download everything not excluded (uses GBs/day):
# GATS_ATTACHMENTS_INCLUDE='[]'
# GATS_ATTACHMENTS_EXCLUDE='["trading window","newspaper","postal ballot"]'
# GATS_RECONCILE_DAYS=7
# GATS_RECONCILE_MAX_ATTEMPTS=3
# GATS_EOD_PUBLISH_AFTER_IST=18:00
# GATS_DAILY_SNAPSHOT_AFTER_IST=08:00

# --- health thresholds (gats status / gats doctor) ---
# GATS_STATUS_HEARTBEAT_STALE_MIN=15
# GATS_STATUS_JOB_FAILING_MIN=30
# GATS_STATUS_BSE_FAILURES_WARN=10
# GATS_STATUS_DATA_WARN_GB=50
# GATS_STATUS_DISK_FREE_WARN_GB=5
# GATS_STATUS_RECONCILE_QUEUE_WARN=4
