# Copy to `.env` and edit. Every setting is optional; defaults are shown.
# All names map to fields in src/gats/config.py (prefix GATS_).

# --- storage ---
# GATS_DATA_DIR=data
# Default is SQLite at data/gats.db. For Postgres (e.g. on the VM):
# GATS_DB_URL=postgresql+psycopg://gats:password@localhost:5432/gats
# GATS_LOG_LEVEL=INFO

# --- politeness: keep these conservative; exchanges block aggressive clients ---
# GATS_MIN_REQUEST_INTERVAL_S=1.0
# GATS_HOST_MIN_INTERVAL_S='{"api.bseindia.com": 2.0}'
# GATS_BSE_PAGE_RETRIES=2
# GATS_BSE_PAGE_RETRY_DELAY_S=15
# GATS_MAX_RETRIES=4
# GATS_HTTP_TIMEOUT_S=20

# --- endpoints (fix here if `gats probe` shows they moved) ---
# GATS_BSE_ANNOUNCEMENTS_URL=https://api.bseindia.com/BseIndiaAPI/api/AnnSubCategoryGetData/w
# GATS_NSE_ANNOUNCEMENTS_URL=https://www.nseindia.com/api/corporate-announcements
# GATS_NSE_EOD_URL_TEMPLATE=https://nsearchives.nseindia.com/products/content/sec_bhavdata_full_{ddmmyyyy}.csv
# GATS_NSE_BANDS_URL=https://nsearchives.nseindia.com/content/equities/sec_list.csv
# GATS_NSE_INSTRUMENTS_URL=https://nsearchives.nseindia.com/content/equities/EQUITY_L.csv

# --- schedule ---
# GATS_BSE_POLL_S=30
# GATS_NSE_POLL_S=120
# GATS_NIGHT_POLL_MULTIPLIER=2.0
# GATS_ATTACHMENTS_ENABLED=true
# Attachment storage policy (URLs are always kept; skipped PDFs can be fetched later).
# GATS_ATTACHMENTS_MAX_MB=5
# Empty include list = download everything not excluded (uses GBs/day):
# GATS_ATTACHMENTS_INCLUDE='[]'
# GATS_ATTACHMENTS_EXCLUDE='["trading window","newspaper","postal ballot"]'
# GATS_RECONCILE_DAYS=7
# GATS_RECONCILE_MAX_ATTEMPTS=3
# GATS_EOD_PUBLISH_AFTER_IST=18:00
# GATS_DAILY_SNAPSHOT_AFTER_IST=08:00

# --- health thresholds (gats status / gats doctor) ---
# GATS_STATUS_HEARTBEAT_STALE_MIN=15
# GATS_STATUS_JOB_FAILING_MIN=30
# GATS_STATUS_BSE_FAILURES_WARN=10
# GATS_STATUS_DATA_WARN_GB=50
# GATS_STATUS_DISK_FREE_WARN_GB=5
# GATS_STATUS_RECONCILE_QUEUE_WARN=4

# --- trading session (NSE market-timings page, checked 2026-10-03) ---
# GATS_SESSION_OPEN_IST=09:15
# GATS_SESSION_CLOSE_IST=15:30

# --- event taxonomy (versioned YAML; stored version = declared + file hash) ---
# GATS_TAXONOMY_PATH=configs/event_taxonomy.yaml
# GATS_CLASSIFY_POLL_S=120

# --- hand-off (M7): new filings are typed and linked at once, and the event
# types a strategy trades get their attachment fetched and read ahead of the
# batch queue. The timer below is only a fallback for a missed wake-up. ---
# GATS_HANDOFF_ENABLED=true
# GATS_HANDOFF_EVENT_TYPES=["ORDER_WIN"]
# GATS_HANDOFF_SOURCES=["NSE"]
# GATS_HANDOFF_FALLBACK_S=30
# GATS_HANDOFF_MAX_AGE_S=3600
# GATS_HANDOFF_MAX_DOWNLOADS=10

# --- paper trading (M7): `gats paper run --name <name>` ---
# What is traded (strategy, costs, risk limits, paper capital) is in the
# versioned config, not here: changing it makes a new paper run.
# GATS_PAPER_CONFIG_PATH=configs/paper.yaml
# Poll of the local database for new filings (not of an exchange).
# GATS_PAPER_POLL_S=2
# A candle counts once its minute ended this long before the broker was asked.
# GATS_PAPER_BAR_MARGIN_S=3
# How long a filing may wait for its text, facts and a price before it is
# handed to the strategy as it is.
# GATS_PAPER_EVENT_WAIT_S=900
# GATS_PAPER_EVENT_LOOKBACK_DAYS=3
# After 15:30, before the day is closed (time for the last candles).
# GATS_PAPER_CLOSE_GRACE_S=300
# GATS_PAPER_FACTS_RETRY_S=30

# --- quarterly results for revenue (T4.7; both verified 2026-10-03) ---
# GATS_NSE_RESULTS_URL=https://www.nseindia.com/api/corporates-financial-results
# GATS_NSE_INTEGRATED_RESULTS_URL=https://www.nseindia.com/api/integrated-filing-results

# --- attachment text and fact extraction (M4) ---
# GATS_EXTRACT_POLL_S=300
# Local LLM through Ollama (POST /api/chat with a JSON schema; verified 2026-10-03).
# The model must appear in `ollama list`.
# GATS_OLLAMA_URL=http://localhost:11434
# GATS_LLM_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
# GATS_LLM_TIMEOUT_S=300
# GATS_LLM_MAX_CHARS=8000

# --- Upstox market data (M5) ---
# SECRET. Read-only Analytics Token (valid a year): generate it at
# https://account.upstox.com/developer/apps#analytics (Analytics tab) and paste it here.
# GATS_UPSTOX_ANALYTICS_TOKEN=
# GATS_UPSTOX_API_BASE=https://api.upstox.com
# GATS_UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz
