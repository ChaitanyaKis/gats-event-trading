{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python *)",
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(.venv/Scripts/gats *)",
      "Bash(.venv/Scripts/gats.exe *)",
      "PowerShell(.venv/Scripts/python *)",
      "PowerShell(.venv\\Scripts\\python *)",
      "PowerShell(.venv/Scripts/gats *)",
      "PowerShell(.venv\\Scripts\\gats *)",
      "Bash(py -m venv *)",
      "PowerShell(py -m venv *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "Bash(ollama list)",
      "PowerShell(ollama list)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Bash(gats live*)",
      "Bash(.venv/Scripts/gats live*)",
      "Bash(.venv/Scripts/gats.exe live*)",
      "PowerShell(gats live*)",
      "PowerShell(.venv/Scripts/gats live*)",
      "PowerShell(.venv\\Scripts\\gats live*)",
      "Bash(gats gate approve*)",
      "Bash(.venv/Scripts/gats gate approve*)",
      "Bash(.venv/Scripts/gats.exe gate approve*)",
      "PowerShell(gats gate approve*)",
      "PowerShell(.venv/Scripts/gats gate approve*)",
      "PowerShell(.venv\\Scripts\\gats gate approve*)",
      "Bash(gats record*)",
      "Bash(.venv/Scripts/gats record*)",
      "Bash(.venv/Scripts/gats.exe record*)",
      "PowerShell(gats record*)",
      "PowerShell(.venv/Scripts/gats record*)",
      "PowerShell(.venv\\Scripts\\gats record*)",
      "Bash(rm *data*)",
      "PowerShell(Remove-Item *data*)",
      "PowerShell(rm *data*)",
      "PowerShell(del *data*)",
      "PowerShell(rmdir *data*)",
      "PowerShell(rd *data*)"
    ]
  }
}
